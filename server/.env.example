# Copy to .env and fill in (never commit .env)
DATABASE_URL=postgres://postgres:<password>@localhost:5432/joblinked
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
PORT=4000
UPLOAD_DIR=uploads
# Comma-separated list of browser origins allowed to call the API. Vite falls
# back to 5174/5175 when 5173 is taken; `npm run preview` serves on 4173.
# Add your production origin here (e.g. https://app.example.com). Unset in
# production = locked to localhost only (warned at boot).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:4173

# Proxy hops in front of the API. Fail-safe default: 0 (nothing assumed in
# front), so req.ip is the real socket address and a client-set
# X-Forwarded-For cannot rotate the rate limiter's per-IP key. A deployment
# behind exactly one proxy (nginx / Caddy / Cloudflare) MUST set 1 — otherwise
# every client shares the proxy's IP for the general/auth/AI limiters. 2+ hops
# = that many hops. A non-numeric value trusts nothing (same as 0).
# Note: local dev has no proxy, so 0 is the correct setting there too.
TRUST_PROXY=0

# AI help chat (ADR-023). Server-side only — never expose as VITE_*.
# Optional: leave the key blank and /api/ai/help returns 503; the API still boots.
OPENROUTER_API_KEY=
# Falls back to openai/gpt-4o-mini ONLY while the base URL is the OpenRouter
# default below; any other base must name its own model.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# NVIDIA recipe: NIM is OpenAI-compatible, so provider choice is configuration.
# OPENROUTER_BASE_URL=https://integrate.api.nvidia.com/v1
# set OPENROUTER_MODEL to an NVIDIA model id; hosted NIM is prototype-grade,
# ~40 RPM, built for prototyping.
# Monitoring (ADR-043). Both optional; the API boots without them.
# METRICS_TOKEN gates GET /api/metrics (send it as the x-metrics-token header).
# Unset = the route answers 404, i.e. it does not exist. Set it to a long random
# string and point your scraper at https://<api-host>/api/metrics every 30-60s.
METRICS_TOKEN=

# ALERT_WEBHOOK_URL receives one small JSON payload per minute at most when a 5xx
# is served (Slack/Discord/generic incoming webhook). Unset = no alerts.
ALERT_WEBHOOK_URL=