# Copy to .env and fill in (never commit .env)
DATABASE_URL=postgres://postgres:<password>@localhost:5432/joblinked
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
PORT=4000
UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:5173

# Proxy hops in front of the API. Fail-safe default: 0 (nothing assumed in
# front), so req.ip is the real socket address and a client-set
# X-Forwarded-For cannot rotate the rate limiter's per-IP key. A deployment
# behind exactly one proxy (nginx / Caddy / Cloudflare) MUST set 1 — otherwise
# every client shares the proxy's IP for the general/auth/AI limiters. 2+ hops
# = that many hops. A non-numeric value trusts nothing (same as 0).
# Note: local dev has no proxy, so 0 is the correct setting there too.
TRUST_PROXY=0

# AI help chat (ADR-023). Server-side only — never expose as VITE_*.
# Optional: leave the key blank and /api/ai/help returns 503; the API still boots.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
