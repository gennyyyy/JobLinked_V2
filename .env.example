# API (Express, local Postgres) — dev default; set to the deployed URL on Vercel
VITE_API_URL=http://localhost:4000
# Supabase Auth only (login/signup/JWT) — data access goes through VITE_API_URL
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
# Cloudflare Turnstile public site key (Supabase CAPTCHA): blank disables the widget
VITE_TURNSTILE_SITE_KEY=
